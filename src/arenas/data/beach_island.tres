[gd_resource type="Resource" script_class="ArenaData" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/arenas/arena_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"beach_island"
display_name = "Beach Island"
tagline = "Sun, sand and sharks. Mind the tide."
title_color = Color(0.3, 0.85, 1, 1)
scene_path = "res://src/arenas/beach_island.tscn"
tips = PackedStringArray("Stand in the glowing ring by the wreck's cannon to be fired onto the lighthouse.", "Every 2 minutes the tide floods the beach: wading is slow, so fight from high ground.", "Past the sand shelf the water is deep, and the sharks are hungry.", "Knock someone off the pier or the rope bridge: the shark kill is yours.", "Smash the bridge planks to cut off the islet.", "The mystery crate lands on top of the lighthouse.")
