[resource]
script = ExtResource("1")
id = &"blockout_yard"
display_name = "Blockout Yard"
tagline = "Grey boxes, real fights. The test arena for the first duel."
title_color = Color(1, 0.6, 0.2, 1)
scene_path = "res://src/arenas/blockout_yard.tscn"
tips = PackedStringArray("Catch a thrown sword to throw it back twice as hard.", "A sprinting swing hits hardest: damage comes from blade speed.", "Hold ATTACK to charge a spinning heavy slash.", "Knock them off the edge: a fall still counts as your kill if you hit them in the last 5 seconds.", "Lock on (LOCK) to circle your opponent and aim throws.", "The last 30 seconds count double.", "Double jump flips you over a swing; roll through attacks to dodge them.")
